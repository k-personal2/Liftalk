---
/* Square "listen" button. app.ts reads data-speak on click, so no per-button script is needed. */
import Icon from "./Icon.astro";

interface Props {
  /** Text to read aloud. */
  text: string;
  size?: "md" | "lg";
  /** BCP 47 voice language; app.ts defaults to en-US. */
  lang?: string;
}
const { text, size = "md", lang } = Astro.props;
const label = lang?.startsWith("zh") ? `Listen in Chinese: ${text}` : `Listen: ${text}`;
---
<button class:list={["iconbtn", { "iconbtn--lg": size === "lg" }]} type="button" data-speak={text} data-speak-lang={lang} aria-label={label}><Icon id="i-speak" /></button>
