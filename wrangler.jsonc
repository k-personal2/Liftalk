{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liftalk",
  "compatibility_date": "2026-10-01",
  // Static assets only — no Worker script, so every request is free and unmetered.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "liftalk.dev", "custom_domain": true }]
}
