{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liftalk",
  "compatibility_date": "2026-10-01",
  // Static assets only — no Worker script, so every request is free and unmetered.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Served on liftalk.<account>.workers.dev until liftalk.dev is added to this Cloudflare account.
  // Then restore: "routes": [{ "pattern": "liftalk.dev", "custom_domain": true }]
  "workers_dev": true
}
